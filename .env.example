# Optional settings. Every value below is the default; nothing is required to run locally.
# Copy to .env (git-ignored) or export them in your shell. See docs/RELEASE.md for CI secrets.

# Streamlit dashboard -> API (docker compose sets http://api:8000)
API_BASE=http://127.0.0.1:8000

# Geod'Air source and region the model was trained on
GEODAIR_BASE_URL=https://files.data.gouv.fr/ineris/lcsqa/concentrations-de-polluants-atmospheriques-reglementes/temps-reel
AQ_ORGANISME=ATMO SUD

# File locations (default: inside the repository)
# AQ_ROOT=.
# AQ_MODEL_PATH=models/best_model.pkl
# AQ_ENCODER_DIR=models/encoders
# AQ_PROCESSED_PATH=data/processed/df_raw_cleaned.csv
# AQ_STATIONS_PATH=data/reference/stations.csv
# AQ_DRIFT_REFERENCE_PATH=data/reference/drift_reference.csv
# AQ_LIVE_DIR=data/live
# AQ_MONITORING_DIR=monitoring

# Training only: where MLflow logs runs (default: sqlite:///mlflow.db)
# MLFLOW_TRACKING_URI=
